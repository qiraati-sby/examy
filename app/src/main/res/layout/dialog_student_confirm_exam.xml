<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/dialog_student_confirm_title"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvStudentSubjectName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="Matematika Peminatan"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Details Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_secondary_button"
        android:orientation="vertical"
        android:padding="12dp">

        <TextView
            android:id="@+id/tvStudentExamSchedule"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="Waktu: 08:00 - 10:00 (Durasi: 90 Menit)"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStudentVolumeStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume HP: 85% (Memenuhi syarat)"
            android:textColor="@color/success"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="Masukkan PIN Siswa dari Pengawas:"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etStudentInputPin"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_input_field"
        android:gravity="center"
        android:hint="****"
        android:importantForAutofill="no"
        android:inputType="numberPassword"
        android:letterSpacing="0.2"
        android:maxLength="8"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_primary"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/tvStudentPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="PIN Siswa salah! Harap cek kembali dengan pengawas."
        android:textColor="@color/danger"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelStudentConfirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:background="@android:color/transparent"
            android:text="@string/btn_cancel"
            android:textAllCaps="false"
            android:textColor="@color/text_secondary" />

        <Button
            android:id="@+id/btnSubmitStudentConfirm"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_primary_button"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:text="Mulai Ujian"
            android:textAllCaps="false"
            android:textColor="@color/text_on_primary"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
