<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootMainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="20dp"
            android:paddingEnd="24dp"
            android:paddingBottom="20dp">

            <!-- Middle Section: Perfectly Centered Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Centered Logo -->
                <ImageView
                    android:id="@+id/ivMainLogo"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:layout_marginBottom="14dp"
                    android:contentDescription="Examy OS Logo"
                    android:src="@mipmap/ic_launcher" />

                <!-- Title: Selamat Datang -->
                <TextView
                    android:id="@+id/tvWelcomeTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:text="Selamat Datang"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <!-- Subtitle: Guidance notice -->
                <TextView
                    android:id="@+id/tvWelcomeSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:text="Pastikan koneksi internet stabil dan gunakan aplikasi dengan bijak selama ujian berlangsung."
                    android:textAlignment="center"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <!-- Theme Selector Capsule (Ganti Warna Tampilan) -->
                <LinearLayout
                    android:id="@+id/layoutThemeSelector"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_secondary_button"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="3dp">

                    <TextView
                        android:id="@+id/btnThemeClassic"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Klasik"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnThemeSantri"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:text="Santri Lime"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Sleek Volume Status Bar -->
                <LinearLayout
                    android:id="@+id/cardVolumeStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/bg_secondary_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="10dp">

                    <ImageView
                        android:id="@+id/ivVolumeIndicator"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_card"
                        android:contentDescription="Volume"
                        android:padding="6dp"
                        android:src="@drawable/ic_volume" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvVolumePercentTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Volume HP: Memeriksa..."
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvVolumeRequirementSubtitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wajib minimal 80% sebelum dapat memulai ujian"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAdjustVolume"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:text="Atur 80%"
                        android:textAllCaps="false"
                        android:textColor="@color/text_on_primary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="8dp" />
                </LinearLayout>

                <!-- Button 1: Pindai QR Code (Solid Primary) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQr"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:text="Pindai QR Code"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_scan_qr"
                    app:iconGravity="textStart"
                    app:iconPadding="10dp"
                    app:iconSize="20dp"
                    app:iconTint="@color/text_on_primary" />

                <!-- Button 2: + Buat Ujian -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateExam"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:text="+ Buat Ujian"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#EA580C"
                    app:cornerRadius="12dp" />

                <!-- Button 3: Input URL Ujian (Outlined) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEnterUrl"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="12dp"
                    android:text="Input URL Ujian"
                    android:textAllCaps="false"
                    android:textColor="@color/primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp" />

                <!-- Button 4: Tutup Aplikasi (Outlined Danger) -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExitApp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:text="Tutup Aplikasi"
                    android:textAllCaps="false"
                    android:textColor="@color/danger"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="#FFFFFF"
                    app:cornerRadius="12dp"
                    app:strokeColor="@color/danger"
                    app:strokeWidth="1.5dp" />

            </LinearLayout>

            <!-- Bottom Section: Security Badge, Operator Santri Branding, and Version -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Security Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="13dp"
                        android:layout_height="13dp"
                        android:contentDescription="Security"
                        android:src="@drawable/ic_lock" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="Kiosk LockTask | Screen Shield | Resilient Network"
                        android:textColor="@color/text_muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Operator Santri Branding -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Operator "
                            android:textColor="#000000"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Santri"
                            android:textColor="#047857"
                            android:textSize="15sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- Garis Bawah Merah -->
                    <View
                        android:id="@+id/viewOperatorUnderline"
                        android:layout_width="match_parent"
                        android:layout_height="3dp"
                        android:layout_marginTop="3dp"
                        android:background="#DC2626" />
                </LinearLayout>

                <!-- Version Label & Update Checker -->
                <TextView
                    android:id="@+id/tvAppVersionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp"
                    android:text="Versi 3 (v1.0.2) • Cek Pembaruan"
                    android:textColor="@color/text_muted"
                    android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
