<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootExamLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <!-- The Fullscreen Secure WebView -->
    <WebView
        android:id="@+id/examWebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Thin Web Page Loading Indicator -->
    <ProgressBar
        android:id="@+id/loadingProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressDrawable="@drawable/bg_primary_button"
        android:visibility="gone"
        tools:progress="60"
        tools:visibility="visible" />

    <!-- Top Minimalist Info Bar (Subject, Countdown Timer & Exit) -->
    <LinearLayout
        android:id="@+id/layoutExamHeaderBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#DDFFFFFF"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/tvExamSubjectTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Ujian Online CBT"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Countdown Timer -->
        <LinearLayout
            android:id="@+id/layoutCountdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_secondary_button"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginEnd="4dp"
                android:contentDescription="Timer"
                android:src="@drawable/ic_time" />

            <TextView
                android:id="@+id/tvExamCountdownTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--:--:--"
                android:textColor="@color/primary"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Exit / Finish Exam Button -->
        <LinearLayout
            android:id="@+id/btnProctorUnlock"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_secondary_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:contentDescription="@string/dialog_exit_title"
                android:src="@drawable/ic_lock" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="Keluar"
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Non-destructive Offline Alert Banner (Does NOT wipe form input!) -->
    <LinearLayout
        android:id="@+id/bannerOffline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="16dp"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_card"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="Offline"
            android:src="@drawable/ic_warning" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alert_offline_title"
                android:textColor="@color/danger"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/alert_offline_desc"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnRetryOffline"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/bg_secondary_button"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Coba Lagi"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Grace Period Countdown Overlay (Zero False Positives: Gives student 5s to return) -->
    <LinearLayout
        android:id="@+id/overlayGracePeriod"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:clickable="true"
        android:elevation="20dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Warning"
                android:src="@drawable/ic_warning" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="@string/alert_grace_title"
                android:textColor="@color/danger"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvGraceCountdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Kembali ke ujian dalam 5 detik!"
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnResumeExam"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_button"
                android:text="Lanjutkan Ujian Sekarang"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Full Violation Screen with SIREN ALARM ACTIVATED -->
    <LinearLayout
        android:id="@+id/overlayViolationLocked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F0EF4444"
        android:clickable="true"
        android:elevation="30dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone"
        tools:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="14dp"
                android:contentDescription="Alarm Active"
                android:src="@drawable/ic_alarm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="@string/alert_violation_title"
                android:textColor="@color/danger"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="HP terkunci dan sirene alarm berbunyi karena pelanggaran keamanan! Panggil Pengawas Ruangan untuk membuka kunci."
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="PIN Pengawas Ruangan:"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etProctorViolationPin"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_input_field"
                android:gravity="center"
                android:hint="****"
                android:importantForAutofill="no"
                android:inputType="numberPassword"
                android:letterSpacing="0.2"
                android:maxLength="8"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:textColor="@color/text_primary"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/tvViolationPinError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:text="PIN Pengawas Salah! Sirene tetap menyala."
                android:textColor="@color/danger"
                android:textSize="12sp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnUnlockViolation"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_button"
                android:text="@string/btn_stop_alarm"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Volume Enforcement Overlay during Exam -->
    <LinearLayout
        android:id="@+id/overlayVolumeBlocked"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/overlay_dim"
        android:clickable="true"
        android:elevation="25dp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:layout_marginBottom="12dp"
                android:contentDescription="Volume Low"
                android:src="@drawable/ic_volume" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:text="Volume HP Di Bawah 80%!"
                android:textColor="@color/danger"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvExamVolumeMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Volume saat ini kurang dari 80%. Aplikasi Examy mewajibkan volume minimal 80% agar alarm keamanan selalu aktif!"
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnExamRaiseVolume"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_primary_button"
                android:text="Naikkan Volume &gt;= 80%"
                android:textAllCaps="false"
                android:textColor="@color/text_on_primary"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
