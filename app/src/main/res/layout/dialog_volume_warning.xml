<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Volume Warning"
        android:src="@drawable/ic_volume" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/alert_volume_title"
        android:textAlignment="center"
        android:textColor="@color/danger"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:text="@string/alert_volume_desc"
        android:textAlignment="center"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvVolumeStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        android:background="@drawable/bg_secondary_button"
        android:padding="12dp"
        android:text="Volume saat ini: 40% (Wajib minimal 80%)"
        android:textAlignment="center"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnAutoRaiseVolume"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_primary_button"
        android:text="@string/btn_set_volume"
        android:textAllCaps="false"
        android:textColor="@color/text_on_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnCheckVolumeAgain"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_secondary_button"
        android:text="@string/btn_check_volume"
        android:textAllCaps="false"
        android:textColor="@color/text_primary"
        android:textSize="14sp" />

</LinearLayout>
